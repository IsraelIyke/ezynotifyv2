# Local Python worker. In production these values are GitHub Actions secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_server_side_service_role_key
BOT_TOKEN=your_main_ezynotify_bot_token
MONITOR_AI_ENDPOINT=https://your-project.supabase.co/functions/v1/ezynotify-ai
MONITOR_AI_SECRET=your_shared_worker_ai_secret
BROWSER_CONCURRENCY=3

# Supabase Edge Function secrets. Do not upload reserved SUPABASE_* names:
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are automatically injected there.
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret
DISPATCH_SECRET=your_random_cron_dispatch_secret
GITHUB_REPOSITORY=IsraelIyke/ezynotifyv2
GITHUB_WORKFLOW=ezynotify.yml
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=your_fine_grained_actions_write_token
GROQ_API_KEY=your_groq_key
# Set model IDs in Supabase secrets; neither model is hardcoded in the worker.
GROQ_MODEL=your_supported_text_model_id
GROQ_VISION_MODEL=your_supported_vision_model_id
# Optional. Clear when changing to a model that does not accept this parameter.
GROQ_REASONING_EFFORT=
GROQ_VISION_REASONING_EFFORT=

# Optional legacy alert bot fallback when BOT_TOKEN is absent from the worker.
# TELEGRAM_BOT_TOKEN=your_keyword_alert_bot_token
# TELEGRAM_UPDATES_BOT_TOKEN=your_update_alert_bot_token
